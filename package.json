{
  "name": "yummi-sushi-delivery",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:cloudflare": "pnpm run build && node scripts/verify-cloudflare-output.mjs",
    "typecheck": "tsc --noEmit",
