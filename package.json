    "verify:menu": "node scripts/verify-menu.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.73.0"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module"
